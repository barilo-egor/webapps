{
  "name": "webapps",
  "private": true,
  "version": "1.0.0",
  "description": "Telegram WebApps for the bot — monorepo with npm workspaces",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:contacts": "npm run dev -w @webapps/contacts",
    "dev:payment-types": "npm run dev -w @webapps/payment-types",
    "build:contacts": "npm run build -w @webapps/contacts",
    "build:payment-types": "npm run build -w @webapps/payment-types",
    "build:all": "npm run build:contacts && npm run build:payment-types",
    "dev:payment-type-categories": "npm run dev -w @webapps/payment-type-categories",
    "build:payment-type-categories": "npm run build -w @webapps/payment-type-categories"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
