{
  "name": "webapps",
  "private": true,
  "version": "1.0.0",
  "description": "Telegram WebApps for the bot — monorepo with npm workspaces",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:contacts": "npm run dev -w @webapps/contacts",
    "dev:payment-types": "npm run dev -w @webapps/payment-types",
    "build:contacts": "npm run build -w @webapps/contacts",
    "build:payment-types": "npm run build -w @webapps/payment-types",
    "build:all": "npm run build:contacts && npm run build:payment-types",
    "dev:payment-type-categories": "npm run dev -w @webapps/payment-type-categories",
    "build:payment-type-categories": "npm run build -w @webapps/payment-type-categories",
    "dev:variables": "npm run dev -w @webapps/variables",
    "build:variables": "npm run build -w @webapps/variables",
    "dev:merchant-histories": "npm run dev -w @webapps/merchant-histories",
    "build:merchant-histories": "npm run build -w @webapps/merchant-histories",
    "dev:withdrawal-history": "npm run dev -w @webapps/withdrawal-history",
    "build:withdrawal-history": "npm run build -w @webapps/withdrawal-history",
    "dev:users": "npm run dev -w @webapps/users",
    "build:users": "npm run build -w @webapps/users",
    "dev:ad-links": "npm run dev -w @webapps/ad-links",
    "build:ad-links": "npm run build -w @webapps/ad-links",
    "dev:bonus": "npm run dev -w @webapps/bonus",
    "build:bonus": "npm run build -w @webapps/bonus",
    "dev:auto-roulette": "npm run dev -w @webapps/auto-roulette",
    "build:auto-roulette": "npm run build -w @webapps/auto-roulette"
  },

  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
