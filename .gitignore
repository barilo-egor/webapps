# Зависимости (восстанавливаются командой npm install из package.json)
**/node_modules/

# Результат сборки (генерируется командой npm run build, делает Jenkins)
**/dist/
**/.vite/

# Локальные файлы конфигурации
.env
.env.local

# IDE и OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Логи
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
